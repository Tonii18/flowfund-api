generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  EXPENSE
  INCOME
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categories   Category[]
  transactions Transaction[]
  savingsGoals SavingsGoal[]
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  type      CategoryType
  // null = categoría predefinida (seed)
  userId    String?      @db.Uuid
  createdAt DateTime     @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id         String   @id @default(uuid()) @db.Uuid
  // siempre positivo; el signo lo da category.type
  amount     Decimal  @db.Decimal(12, 2)
  date       DateTime @db.Date
  note       String?
  categoryId String   @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // NoAction = bloquea el borrado de la categoría (equivale a RESTRICT),
  // pero se comprueba al final de la sentencia, así no rompe el borrado en cascada de User.
  category Category @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([categoryId])
}

model SavingsGoal {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  targetAmount Decimal   @db.Decimal(12, 2)
  deadline     DateTime? @db.Date
  userId       String    @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId])
}

model GoalContribution {
  id        String   @id @default(uuid()) @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @db.Date
  goalId    String   @db.Uuid
  createdAt DateTime @default(now())

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

